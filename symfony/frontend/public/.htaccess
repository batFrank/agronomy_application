DirectoryIndex index.html index.html
<IfModule mod_rewrite.c>
    RewriteEngine On
    Header Set Cache-Control "max-age=0, no-store"

    RewriteBase /app
    RewriteRule ^app/index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /app/index.html [L]
</IfModule>
