{
  "name": "demo-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun ./src/core/scripts/server.scripts.js",
    "build": "bun ./src/core/scripts/build.scripts.js",
    "build-favicon": "bun ./src/core/scripts/favicon.scripts.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "locales": "bun ./src/core/scripts/locales.scripts.js",
    "new-client": "bun ./src/core/scripts/clientsFactory.scripts.js",
    "tests": "bun ./src/core/scripts/tests.scripts.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prettier": "prettier --write src/",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "format": "bun run lint --fix && bun run prettier"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.2.0",
    "@sentry/vue": "^10.56.0",
    "@vuepic/vue-datepicker": "^14.0.0",
    "axios": "^1.16.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.35",
    "vue-i18n": "^11.4.4",
    "vue-router": "^5.1.0",
    "vue3-select-component": "^0.16.2",
    "vue3-toastify": "^0.2.9"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/vue3-vite": "10.6.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.11",
    "cross-env": "^10.1.0",
    "enquirer": "^2.4.1",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.1",
    "glob": "^13.0.6",
    "globals": "^17.6.0",
    "happy-dom": "^20.10.6",
    "joi": "^18.2.1",
    "miragejs": "^0.1.48",
    "prettier": "^3.8.3",
    "sass": "^1.100.0",
    "sass-embedded": "^1.100.0",
    "storybook": "10.6.0",
    "vite": "^8.0.16",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^4.1.8"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
