VITE_BASE_URL=/app/
# Dev server proxy target — uses Docker service name by default.
# Override with http://localhost:8011 if running Vite outside Docker.
VITE_API_PROXY_TARGET=http://symfony-base-apache
#VITE_TEST_USER=admin@admin.com // add a valid email in .env.dev.local
#VITE_TEST_PASS=password1234 // add a valid password in .env.dev.local
#VITE_TEST_ROLES=ROLE_ADMIN // add a valid role in .env.dev.local
VITE_API_URL=/api/v1