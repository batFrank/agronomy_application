{% extends 'email/base.html.twig' %}

{% block title %}Recuperar contraseña{% endblock %}

{% block body %}
    <h2>Recuperar contraseña</h2>
    <p>¡Hola!</p>
    <p>Has solicitado recuperar tu contraseña para tu cuenta.</p>

    <div class="highlight-box">
        <p><strong>🔐 Para restablecer tu contraseña, haz clic en el siguiente botón:</strong></p>
        <p style="text-align: center; margin: 20px 0;">
            <a href="{{ reset_url }}" class="button">Restablecer contraseña</a>
        </p>
        <p style="font-size: 12px; color: #666;">
            Si el botón no funciona, copia y pega este enlace en tu navegador:<br>
            <a href="{{ reset_url }}">{{ reset_url }}</a>
        </p>
    </div>

    <p><strong>⚠️ Importante:</strong></p>
    <ul>
        <li>Este enlace expirará en 24 horas por seguridad</li>
        <li>Si no has solicitado recuperar tu contraseña, ignora este mensaje</li>
        <li>Tu contraseña actual seguirá siendo válida hasta que la cambies</li>
    </ul>

    <p>Si tienes algún problema, no dudes en contactarnos.</p>
{% endblock %}
